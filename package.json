{
  "name": "tafaseel-training",
  "version": "2.0.0",
  "description": "منصة تدريب عربية بحسابات متدربين ولوحة إدارة وقاعدة بيانات",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy:build": "npm run build && node scripts/prepare-pages.mjs",
    "lint": "eslint .",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "format": "prettier --write src scripts index.html vite.config.ts eslint.config.js *.md *.json",
    "format:check": "prettier --check src scripts index.html vite.config.ts eslint.config.js *.md *.json"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "lighthouse": "^13.4.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
